  notificationConsentEpoch Int?     @map("notification_consent_epoch")
  status                   String
  suppressionReason        String?  @map("suppression_reason")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferenceRevision       ReminderPreferenceRevision @relation(fields: [userId, preferenceVersion], references: [userId, version], onDelete: Cascade)

  @@unique([userId, kind, periodStart])
  @@index([status, scheduledAt, kind])
  @@map("schedule_plans")
}

model SchedulerWatermark {
  userId          String    @id @map("user_id") @db.Uuid
  lastEvaluatedAt DateTime? @map("last_evaluated_at") @db.Timestamptz(6)
  lastLocalDate   DateTime? @map("last_local_date") @db.Date
  timezone        String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("scheduler_watermarks")
}

model SafetyIncident {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String?      @map("user_id") @db.Uuid
  source           String
  severity         String
  status           RecordStatus @default(pending)
  detailsEncrypted String       @map("details_encrypted")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, severity, createdAt])
  @@map("safety_incidents")
}
