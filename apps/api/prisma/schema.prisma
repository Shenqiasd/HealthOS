  fromSnapshot   RecommendationSnapshot?       @relation("ReviewEventFrom", fields: [fromSnapshotId], references: [id], onDelete: Cascade)
  toSnapshot     RecommendationSnapshot?       @relation("ReviewEventTo", fields: [toSnapshotId], references: [id], onDelete: Cascade)

  @@unique([toSnapshotId, eventType])
