model RecommendationSnapshot {
  id                     String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId                  String                      @map("run_id") @db.Uuid
  revision               Int
  riskArea               String?                     @map("risk_area")
  safetyClass            String                      @map("safety_class")
  actionCode             String?                     @map("action_code")
  renderedPayloadJson    Json                        @map("rendered_payload_json") @db.JsonB
  canonicalRuleInputJson Json                        @map("canonical_rule_input_json") @db.JsonB
  provenanceJson         Json                        @map("provenance_json") @db.JsonB
  snapshotHash           String?                     @map("snapshot_hash")
  releaseStage           String?                     @map("release_stage")
  reviewRoute            String?                     @map("review_route")
  policyDigest           String?                     @map("policy_digest")
  samplingBucket         Int?                        @map("sampling_bucket")
  reviewSamplePercent    Int?                        @map("review_sample_percent")
  reviewStatus           RecommendationReviewStatus  @default(draft) @map("review_status")
  supersedesId           String?                     @map("supersedes_id") @db.Uuid
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  run                    RecommendationRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  supersedes             RecommendationSnapshot?     @relation("RecommendationSupersession", fields: [supersedesId], references: [id], onDelete: Cascade)
  supersededBy           RecommendationSnapshot[]    @relation("RecommendationSupersession")
  actions                ActionAssignment[]
  reviewEvents           RecommendationReviewEvent[] @relation("ReviewEventSubject")
  reviewEventsFrom       RecommendationReviewEvent[] @relation("ReviewEventFrom")
  reviewEventsTo         RecommendationReviewEvent[] @relation("ReviewEventTo")
  publications           RecommendationPublication[]
  reviewTasks            RecommendationReviewTask[]
  signals                SignalSnapshot[]

  @@unique([runId, revision])
  @@index([runId, reviewStatus])
  @@map("recommendation_snapshots")
}

model RecommendationReviewEvent {
  id             String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  snapshotId     String                        @map("snapshot_id") @db.Uuid
